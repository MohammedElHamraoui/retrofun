{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml"
  },
  "include": [
    "src/**/*.py",
    "docs/**/*.md",
    "pyproject.toml",
    "README.md",
    "migrations/**/*.py",
    "classes_retrofun.mmd",
    "packages_retrofun.mmd"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "uv.lock",
      "repomix-output.*",
      ".env"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}